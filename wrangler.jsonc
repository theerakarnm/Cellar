{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cellar",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "dist/ui",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/internal/*"]
  },
  // Placeholder IDs and names. Replace with real values only after the owner approves creating the resources.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cellar",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "cellar-backups" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "cellar-jobs" }],
    "consumers": [{ "queue": "cellar-jobs", "max_batch_size": 1, "max_retries": 100 }]
  },
  "triggers": { "crons": ["* * * * *"] },
  // Placeholders. Local development overrides them in .dev.vars. Never commit a real account id.
  "vars": { "APP_BASE_URL": "https://cellar.example.com", "R2_BUCKET": "cellar-backups", "R2_ENDPOINT": "https://ACCOUNT_ID.r2.cloudflarestorage.com" },
  "containers": [
    {
      "class_name": "JobRunner",
      "image": "./container/Dockerfile",
      "image_build_context": ".",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "durable_objects": { "bindings": [{ "name": "JOB_RUNNER", "class_name": "JobRunner" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["JobRunner"] }]
}
