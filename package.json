{
  "name": "cellar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:api": "wrangler dev",
    "dev:ui": "vite ui",
    "build:ui": "vite build ui",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p container && tsc -p ui --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply cellar --local",
    "db:migrate:remote": "wrangler d1 migrations apply cellar --remote",
    "deploy": "bun run build:ui && wrangler deploy"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
